generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model certificados {
  id            Int     @id @default(autoincrement())
  nome          String  @db.VarChar(200)
  carga_horaria Int?    @default(0)
  ano           Int?    @default(2025) @db.Year
  instituicao   String? @default("") @db.VarChar(150)
}

model competencias {
  id   Int               @id @default(autoincrement())
  tipo competencias_tipo
  nome String            @db.VarChar(100)

  @@unique([tipo, nome], map: "uq_competencia")
}

model formacoes {
  id          Int     @id @default(autoincrement())
  instituicao String  @db.VarChar(150)
  curso       String? @default("") @db.VarChar(200)
  status      String? @default("") @db.VarChar(100)
}

model projeto_tecnologias {
  id         Int      @id @default(autoincrement())
  projeto_id Int
  tecnologia String   @db.VarChar(80)
  projetos   projetos @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "projeto_tecnologias_ibfk_1")

  @@index([projeto_id], map: "projeto_id")
}

model projetos {
  id                  Int                   @id @default(autoincrement())
  nome                String                @db.VarChar(150)
  descricao           String?               @db.Text
  imagem              String?               @default("") @db.VarChar(255)
  github              String?               @default("") @db.VarChar(255)
  site                String?               @default("") @db.VarChar(255)
  criado_em           DateTime?             @default(now()) @db.Timestamp(0)
  empresa             String                @default("")  
  professor           String                @default("")  
  projeto_tecnologias projeto_tecnologias[]
}

model usuarios {
  id      Int    @id @default(autoincrement())
  usuario String @unique(map: "usuario") @db.VarChar(100)
  senha   String @db.VarChar(255)
}

enum competencias_tipo {
  tecnica
  interpessoal
}
